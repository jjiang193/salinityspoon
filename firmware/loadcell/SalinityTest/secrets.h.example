/*
 * secrets.h - Wi-Fi and AWS IoT credentials. NEVER COMMIT THIS FILE.
 *
 * The device certificate and private key were created by
 * infra/scripts/create-device-cert.sh and also live in ~/natrack-certs/spoon-01/.
 * The key identifies this spoon to AWS: anyone holding it can publish as
 * spoon-01. If it leaks, deactivate the certificate in IoT Core and make a new
 * one - that is a two-minute job, so do it rather than hope.
 */
#ifndef SECRETS_H
#define SECRETS_H

// ---- Wi-Fi: fill these in ----
#define WIFI_SSID ""
#define WIFI_PASSWORD ""xxxx-ats.iot.us-east-1.amazonaws.com"
#define AWS_IOT_CLIENT_ID  "spoon-01"
#define AWS_IOT_TOPIC      "devices/spoon-01/bites"

// Paste the three PEM files from infra/scripts/create-device-cert.sh here.
static const char AWS_ROOT_CA[] = R"EOF(
-----BEGIN CERTIFICATE-----
...AmazonRootCA1.pem...
-----END CERTIFICATE-----
)EOF";

static const char DEVICE_CERT[] = R"EOF(
-----BEGIN CERTIFICATE-----
...certificate.pem.crt...
-----END CERTIFICATE-----
)EOF";

static const char DEVICE_KEY[] = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
...private.pem.key...
-----END RSA PRIVATE KEY-----
)EOF";

#endif
